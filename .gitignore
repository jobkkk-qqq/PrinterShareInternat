# 依赖与构建产物
node_modules/
dist/
.buildcache/
.electron-cache/
.eu/
.npmcache/
.env
.trae-html-share-packages/

# 日志
*.log
.npm-install.log

# 运行期数据（打印任务队列、本机配置——含机器名/打印机名）
queue/*
!queue/.gitkeep
config.json
# 授权状态（本机机器码 / 注册码 / 已打印计数），属运行期数据
license.json

# 客户端安装脚本（运行期按需生成下载；若落到项目目录不入库）
install-printer.bat

# 许可签名私钥（Ed25519 发码用）——绝不入库、绝不进 exe。
# 程序里只有公钥；私钥只留在开发者本机（默认在仓库外的 license-keys/ 目录）。
license-private-key.json
*private-key*.json
license-keys/
